{
	"name": "codeui-monorepo",
	"private": true,
	"description": "Monorepo for CodeUI library",
	"version": "0.0.1",
	"license": "MIT",
	"author": "riccardoperra",
	"contributors": [],
	"scripts": {
		"dev": "turbo run dev --parallel",
		"build": "turbo run build",
		"api:update": "node tools/api-snapshot.mjs --update",
		"api:check": "node tools/api-snapshot.mjs",
		"build:kit": "turbo run build --filter=@codeui/kit",
		"test": "turbo run test --filter=!@codeui/*playground && pnpm run test:stories",
		"typecheck": "turbo run typecheck --filter=!@codeui/*playground",
		"build-test": "turbo run build test typecheck --filter=!@codeui/*playground",
		"format": "prettier -w \"packages/**/*.{js,ts,json,css,tsx,jsx,md}\" \"playgrounds/**/*.{js,ts,json,css,tsx,jsx,md}\"",
		"changeset": "changeset",
		"version-packages": "changeset version && pnpm i",
		"ci:version": "changeset version && pnpm i --no-frozen-lockfile && git add .",
		"release": "turbo run build --filter=@codeui/kit --filter=@codeui/react && changeset publish",
		"update-deps": "taze -w -r && pnpm i",
		"publish": "changeset publish",
		"prepublish": "pnpm build",
		"docs:scaffold": "node tools/docs/scaffold.mjs",
		"docs:coverage": "node tools/docs/coverage.mjs",
		"docs:check-llms": "node tools/docs/check-llms.mjs",
		"docs:lint": "node tools/docs/lint-demos.mjs && node tools/docs/lint-links.mjs && node tools/docs/lint-anatomy.mjs",
		"palette:generate": "node tools/palette/generate.mjs",
		"test:hydration": "pnpm --filter @codeui/kit test:hydration",
		"test:stories": "pnpm --filter @codeui/storybook-playground test:stories"
	},
	"devDependencies": {
		"@changesets/cli": "^2.27.8",
		"@testing-library/jest-dom": "6.5.0",
		"@types/node": "^22.5.4",
		"@vitest/browser": "3.2.7",
		"jsdom": "20.0.3",
		"playwright": "1.56.1",
		"prettier": "3.3.3",
		"rollup": "^4.21.3",
		"rollup-preset-solid": "^2.0.1",
		"solid-js": "^1.9.8",
		"taze": "^0.16.8",
		"turbo": "^2.1.1",
		"typescript": "^5.6.2",
		"vite": "^5.4.4",
		"vite-plugin-solid": "2.11.8",
		"vitest": "3.2.7"
	},
	"packageManager": "pnpm@10.34.9",
	"dependencies": {
		"@changesets/changelog-git": "^0.2.0"
	},
	"engines": {
		"node": "^24.11.0 || >=26.0.0"
	}
}
