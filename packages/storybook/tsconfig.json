{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"lib": [
			"ES2020",
			"DOM",
			"DOM.Iterable"
		],
		"skipLibCheck": true,
		/* Bundler mode */
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"allowJs": false,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"@codeui/kit": [
				"../kit/src/index.tsx"
			],
			"@codeui/kit/dialog/parts": [
				"../kit/src/parts/dialog.tsx"
			],
			"@codeui/kit/accordion/parts": [
				"../kit/src/parts/accordion.tsx"
			],
			"@codeui/kit/popover/parts": [
				"../kit/src/parts/popover.tsx"
			],
			"@codeui/kit/combobox/parts": [
				"../kit/src/parts/combobox.tsx"
			],
			"@codeui/kit/command-menu/parts": [
				"../kit/src/parts/command-menu.tsx"
			],
			"@codeui/kit/alert/parts": [
				"../kit/src/parts/alert.tsx"
			],
			"@codeui/kit/toast/parts": [
				"../kit/src/parts/toast.tsx"
			],
			"@codeui/kit/sheet/parts": [
				"../kit/src/parts/sheet.tsx"
			]
		}
	},
	"include": [
		"./src/**/*.ts",
		"./src/**/*.tsx",
	]
}
