{
	"name": "@codeui/kit",
	"version": "0.1.5",
	"description": "Open-Source UI Kit library for CodeImage",
	"license": "MIT",
	"author": "riccardoperra",
	"contributors": [],
	"homepage": "https://github.com/riccardoperra/codeui#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/riccardoperra/codeui.git"
	},
	"bugs": {
		"url": "https://github.com/riccardoperra/codeui/issues"
	},
	"keywords": [
		"solid",
		"codeui",
		"codeimage",
		"uikit",
		"kobalte",
		"headless"
	],
	"private": false,
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"DESIGN.md"
	],
	"type": "module",
	"module": "dist/esm/index.js",
	"types": "dist/types/index.d.ts",
	"exports": {
		".": {
			"solid": {
				"types": "./dist/types/index.d.ts",
				"default": "./dist/source/index.jsx"
			},
			"import": {
				"types": "./dist/types/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/types-cjs/index.d.cts",
				"default": "./dist/cjs/index.cjs"
			}
		},
		"./dialog": {
			"solid": {
				"types": "./dist/types/parts/dialog.d.ts",
				"default": "./dist/source/parts/dialog.jsx"
			},
			"import": {
				"types": "./dist/types/parts/dialog.d.ts",
				"default": "./dist/esm/parts/dialog.js"
			},
			"require": {
				"types": "./dist/types-cjs/parts/dialog.d.cts",
				"default": "./dist/cjs/parts/dialog.cjs"
			}
		},
		"./popover": {
			"solid": {
				"types": "./dist/types/parts/popover.d.ts",
				"default": "./dist/source/parts/popover.jsx"
			},
			"import": {
				"types": "./dist/types/parts/popover.d.ts",
				"default": "./dist/esm/parts/popover.js"
			},
			"require": {
				"types": "./dist/types-cjs/parts/popover.d.cts",
				"default": "./dist/cjs/parts/popover.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"typesVersions": {
		"*": {
			"dialog": [
				"dist/types/parts/dialog.d.ts"
			],
			"popover": [
				"dist/types/parts/popover.d.ts"
			]
		}
	},
	"scripts": {
		"dev": "pnpm run build -w",
		"build": "rollup -c rollup.config.js",
		"test": "pnpm run test:client && pnpm run test:ssr",
		"test:client": "jest --config jest.config.ts",
		"test:ssr": "jest --config jest.config.ssr.ts",
		"typecheck": "tsc --noEmit",
		"prepublish": "pnpm build"
	},
	"devDependencies": {
		"@codeui/vanilla-extract": "workspace:*",
		"@testing-library/jest-dom": "^6.5.0",
		"@vanilla-extract/jest-transform": "1.1.11",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"rollup": "^4.21.3",
		"rollup-preset-solid": "^2.0.1",
		"solid-js": "^1.9.8",
		"solid-testing-library": "^0.5.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.6.2",
		"vite-tsconfig-paths": "^5.0.1",
		"@vanilla-extract/vite-plugin": "^4.0.15",
		"motion": "^10.18.0"
	},
	"peerDependencies": {
		"solid-js": "^1.9.8"
	},
	"packageManager": "pnpm@7.33.7",
	"dependencies": {
		"@kobalte/core": "^0.13.14",
		"@kobalte/utils": "^0.9.2",
		"@kobalte/vanilla-extract": "^0.5.0",
		"@maskito/core": "^3.0.1",
		"@maskito/kit": "^3.0.1",
		"@radix-ui/colors": "^3.0.0",
		"@solid-primitives/pagination": "^0.3.0",
		"@solid-primitives/scheduled": "^1.4.3",
		"@tanstack/solid-virtual": "^3.10.7",
		"@vanilla-extract/css": "^1.15.5",
		"@vanilla-extract/dynamic": "^2.1.2",
		"@vanilla-extract/recipes": "^0.5.5",
		"polished": "^4.3.1"
	},
	"main": "dist/cjs/index.cjs"
}
