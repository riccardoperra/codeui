		"test": "pnpm run test:client && pnpm run test:ssr && pnpm run test:tokens-consumer",
		"test:client": "jest --config jest.config.ts",
		"test:ssr": "jest --config jest.config.ssr.ts",
		"typecheck": "tsc --noEmit",
		"prepublish": "pnpm build",
		"test:tokens-consumer": "pnpm run build && node fixtures/tokens-consumer/check.mjs && node fixtures/tokens-consumer/check.mjs --solid"
