{
	"name": "@codeui/docs-demos",
	"private": true,
	"type": "module",
	"exports": {
		"./client": {
			"types": "./client.d.ts",
			"default": "./dist/client/client.js"
		},
		"./server": {
			"types": "./server.d.ts",
			"default": "./dist/server/server.js"
		},
		"./style.css": "./dist/client/demos.css"
	},
	"scripts": {
		"build": "vite build && vite build --ssr src/server.tsx",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@codeui/inkstone": "workspace:*",
		"@codeui/kit": "workspace:*",
		"@kobalte/core": "2.0.0-alpha.5",
		"solid-js": "2.0.3",
		"@solidjs/web": "2.0.3",
		"@codeui/styles": "workspace:*"
	},
	"devDependencies": {
		"typescript": "^5.6.2",
		"vite": "8.3.8",
		"@solidjs/vite-plugin": "3.0.1"
	}
}
