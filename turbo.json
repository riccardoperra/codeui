{
	"$schema": "https://turborepo.org/schema.json",
	"tasks": {
		"@codeui/playground#build": {
			"dependsOn": [
				"@codeui/kit#build"
			]
		},
		"build": {
			"dependsOn": [
				"^build"
			],
			"outputs": [
				"dist/**"
			]
		},
		"test": {
			"dependsOn": [
				"^build"
			]
		},
		"typecheck": {
			"dependsOn": [
				"^build"
			]
		},
		"dev": {
			"cache": false
		},
		"@codeui/docs#build": {
			"dependsOn": [
				"^build"
			],
			"env": [
				"NITRO_PRESET"
			],
			"outputs": [
				".output/**",
				"dist/**"
			]
		}
	}
}
