{
	"$schema": "https://turborepo.org/schema.json",
	"tasks": {
		"@codeui/react#test": {
			"dependsOn": ["build"]
		},
		"@codeui/inkstone#test": {
			"dependsOn": ["build"]
		},
		"@codeui/styles#test": {
			"dependsOn": ["build"],
			"cache": false
		},
		"@codeui/playground#build": {
			"dependsOn": ["@codeui/kit#build"]
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"dev": {
			"cache": false
		},
		"@codeui/docs#build": {
			"dependsOn": [
				"^build"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				"../../tools/palette/**"
			],
			"env": [
				"NITRO_PRESET"
			],
			"outputs": [
				".output/**",
				"dist/**"
			]
		},
		"@codeui/kit#test": {
			"dependsOn": [
				"build"
			]
		}
	}
}
