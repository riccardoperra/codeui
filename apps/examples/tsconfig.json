{
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "es2022",
		"lib": ["es2023", "dom", "dom.iterable"],
		"strict": true,
		"skipLibCheck": true,
		"types": ["vite/client"],
		"noEmit": true
	},
	"include": ["src", "vite.config.ts"]
}
