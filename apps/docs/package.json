{
	"name": "@codeui/docs",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"dev": "node scripts/generate-props.mjs && node scripts/copy-examples.mjs && pnpm palette && vite dev",
		"build": "node scripts/generate-props.mjs && node scripts/copy-examples.mjs && pnpm palette && vite build && node scripts/cloudflare-routes.mjs",
		"start": "vite preview",
		"typecheck": "tsc --noEmit",
		"props": "node scripts/generate-props.mjs",
		"palette": "node ../../tools/palette/generate.mjs docs-css .generated/inkstone-docs.css && node ../../tools/palette/generate.mjs reference .generated/inkstone-palette.json"
	},
	"dependencies": {
		"@codeui/docs-demos": "workspace:*",
		"@codeui/examples": "workspace:*",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-devtools": "1.167.3",
		"@tanstack/react-start": "1.169.5",
		"cn": "^0.5.2",
		"fumadocs-core": "16.19.3",
		"fumadocs-mdx": "15.6.2",
		"fumadocs-ui": "npm:@fumadocs/base-ui@16.19.3",
		"lucide-react": "^1.71.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.5",
		"@types/mdx": "^2.0.14",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"fumadocs-typescript": "5.6.2",
		"nitro": "3.0.261103-rc",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"wrangler": "4.156.2"
	}
}
